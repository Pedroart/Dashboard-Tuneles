var mobile = window.matchMedia("(max-width: 600px)")
function matches(x) {
    if (x.matches) { $('select').addClass('browser-default') }
    else { $('select').removeClass('browser-default') }
    $('select').formSelect();
}
matches(mobile);

$(window).resize(function () {
    matches(mobile);
});

