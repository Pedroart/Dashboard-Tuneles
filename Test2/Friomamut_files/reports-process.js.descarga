function Measurements(environments) {
    var data = { Identifier: environments };

    $.ajax({
        type: "POST",
        contentType: "application/json",
        url: '/Reports/Measurements',
        data: JSON.stringify(data),
        dataType: "json",
        async: true,
        processData: false,
        timeout: 60000,
        beforeSend: function () {
            $('nav .wrapper-download').hide();
        },
        success: function (data) {
            $('nav .wrapper-download').show();
            var collection = JSON.parse(data);

            $('#measurements thead').empty();
            $('#measurements tbody').empty();

            var encabezados = [];
            for (var i = 0; i < 1; i++) {
                var counter = collection[i];
                $('#measurements thead').html('<tr></tr>');

                for (key in counter) {
                    var center = (key === 'LECTURA') ? '' : 'center';
                    $('#measurements thead tr:last').append('<th><div class="flex ' + center + '">' + key.replace(/_/g, ' ') + '</div></th>');
                    var headers = 'counter.' + key;
                    encabezados.push(headers);
                }
            }

            for (var i = 0; i < collection.length; i++) {
                var counter = collection[i];
                $('#measurements tbody').append('<tr>');
                for (var j = 0; j < encabezados.length; j++) {
                    if (encabezados[j] == 'counter.LECTURA') {
                        var date = 'new Date(' + encabezados[j] + ').toLocaleString("es-PE", { year: "numeric", month: "2-digit", day: "2-digit", hour: "2-digit", minute: "2-digit", second: "2-digit", hour12: false}).replace(",", "")';
                        $('#measurements tbody tr:last').append('<td><div class="flex color-date">' + eval(date) + '</div></td>');
                    } else {
                        var value = eval(encabezados[j]);
                        
                        $('#measurements tbody tr:last').append('<td><div class="flex center ' + ((value === null) ? 'attenuate' : '') + '">' + ((value !== null) ? parseFloat(value).toFixed(1) : '<div class="empty empty-small"></div>') + '</div></td>');
                    }
                }
            }

        }, complete: function () {


        }, error: function (error) {
            $('nav .wrapper-download').hide();
            console.log(error);
        }
    });
}

function Available() {
    $.ajax({
        type: "GET",
        contentType: "application/json",
        url: '/Reports/Available.json',
        dataType: "json",
        async: true,
        beforeSend: function () {

        },
        success: function (data) {
            var collection = JSON.parse(data);

            $('#environments').empty();
            $('#environments').append('<option value="-1" disabled selected>Selecciona alguno de los ambientes</option>');
            if (collection.length > 0) {
                for (i = 0; i < collection.length; i++) {
                    var datos = collection[i];

                    if (datos.Visibilidad) {
                        $('#environments').append('<option value="' + datos.Identificador + '">' + datos.Descripcion + '</option>');
                    }
                }
            }
        },
        complete: function () {
            $('#environments').formSelect();
        }, error: function (error) {

        }
    });
}
