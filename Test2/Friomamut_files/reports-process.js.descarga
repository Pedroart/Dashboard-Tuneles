function Filter(parameters) {
    fetch('/Reports/Filter', {
        method: 'POST',
        headers: {
            'Content-Type': 'application/json'
        },
        body: JSON.stringify({
            Parameters: parameters
        })
    })
        .then(response => response.json())
        .then(response => {
            var data = JSON.parse(response);

            

            $('.handpick').empty();
            const handpick = document.getElementById('handpick');

            const format = fecha => new Date(fecha).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false });
            const agrupado = data.reduce((acc, item) => {
                const dia = item.Fecha.split('T')[0];
                acc[dia] ??= [];
                acc[dia].push(item);
                return acc;
            }, {});

            Object.entries(agrupado).forEach(([dia, eventos]) => {

                const element = document.createElement('div');
                element.className = 'group';

                element.innerHTML = '<div class="header">' + longDate(dia) + '</div>';

                eventos.forEach(e => {

                    const context = document.createElement('div');
                    context.className = 'content';

                    context.innerHTML =
                        '<div class="element" data-identifier="' + e.Identificador + '">' +
                        '<div class="circle">' + '</div>' +
                        '<div class="hour">' + format(e.Fecha) + '</div>' +
                        '<span>' + e.Descripcion + '</span>' +
                        '</div>';

                    element.appendChild(context);
                });

                handpick.appendChild(element);
            });

            if (data.length < 1) {
                $('.handpick').append(
                    '<div class="group">' +
                        '<div class="content">' +
                            '<div class="blank">' +
                                '<span>No se encontraron datos</span>' +
                           '</div>' +
                        '</div>' +
                    '</div>'
                );
            }
        })
        .catch(error => {
            console.log(error);
        })
        .finally(() => {

        });
}

Available();
Status();

/* layout:context */
$('.wrapper-context .context').Context();

$('nav .wrapper-button .button').click(function () {
    $('.wrapper-context').fadeIn(300);
    $('.wrapper-context .context').css({ 'transform': 'translateX(0)' });

    history.pushState({ layer: true }, "");
});

$('.wrapper-handpick .handpick').on('click', '.element', function () {
    const element = $(this);

    if (element.hasClass('active')) {
        element.removeClass('active');
    } else {
        $('.wrapper-handpick .handpick .element').removeClass('active');
        element.addClass('active');
    }
});

const now = new Date();
const init = { container: 'body', i18n: language, format: 'dd/mm/yyyy', setDefaultDate: true, defaultDate: new Date(), autoClose: true, onClose: function () { } };
const finish = { container: 'body', i18n: language, format: 'dd/mm/yyyy', setDefaultDate: true, defaultDate: new Date(), autoClose: true, onClose: function () { } };

init.defaultDate = new Date(now.getFullYear(), now.getMonth(), 1);
finish.defaultDate = new Date();

$('#init').datepicker(init);
$('#finish').datepicker(finish);

$('#periods').change(function () {
    var datos = $('#periods option:selected').val();

    switch (parseInt(datos)) {
        case 0:
            $('.customizable').show();
            init.defaultDate = new Date();
            finish.defaultDate = new Date();

            $('#init').datepicker(init);
            $('#finish').datepicker(finish);
            break;
        case 1:
            $('.customizable').hide();
            init.defaultDate = new Date(now.getFullYear(), now.getMonth(), 1);
            finish.defaultDate = new Date();

            $('#init').datepicker(init);
            $('#finish').datepicker(finish);
            break;
        case 2:
            $('.customizable').hide();
            init.defaultDate = new Date(now.getFullYear(), now.getMonth() - 1, 1);
            finish.defaultDate = new Date();

            $('#init').datepicker(init);
            $('#finish').datepicker(finish);
            break;
        case 6:
            $('.customizable').hide();
            init.defaultDate = new Date(now.getFullYear(), now.getMonth() - 5, 1);
            finish.defaultDate = new Date();

            $('#init').datepicker(init);
            $('#finish').datepicker(finish);
            break;
        default:
            $('.customizable').hide();
            break;
    }

    var _init = $('#init').val();
    var _finish = $('#finish').val();

    var environments = $('#environments option:selected').val();
    var status = $('#status option:selected').val();

    var parameters = [];
    var content = { Init: _init, Finish: _finish, Environment: parseInt(environments), Status: parseInt(status) };
    parameters.push(content);

    Filter(JSON.stringify(parameters));
});

$('#environments').change(function () {
    var _init = $('#init').val();
    var _finish = $('#finish').val();

    var environments = $('#environments option:selected').val();
    var status = $('#status option:selected').val();

    var parameters = [];
    var content = { Init: _init, Finish: _finish, Environment: parseInt(environments), Status: parseInt(status) };
    parameters.push(content);

    Filter(JSON.stringify(parameters));
