let trends = null;
var identifier = null;

var inheritance = [];

function isValidDate(f1, f2) {
    return f1.getDate() === f2.getDate() &&
        f1.getMonth() === f2.getMonth() &&
        f1.getFullYear() === f2.getFullYear();
}
function isWeek(texto) {
    if (!texto) return '';
    return texto.charAt(0).toUpperCase() + texto.slice(1).toLowerCase();
}
function longDate(fechaISO) {
    const [y, m, d] = fechaISO.split('T')[0].split('-');

    return new Date(y, m - 1, d, 12).toLocaleDateString('es-PE', {
        weekday: 'long',
        day: '2-digit',
        month: 'long',
        year: 'numeric'
    });
}
function Process(process) {
    var data = { Identifier: process };

    $.ajax({
        type: "POST",
        contentType: "application/json",
        url: '/Reports/Process',
        data: JSON.stringify(data),
        dataType: "json",
        async: true,
        beforeSend: function () {

        },
        success: function (data) {
            var collection = JSON.parse(data);

            inheritance = [];

            if ($('span').hasClass('empty')) {
                $('span').removeClass('empty');
                $('span').removeClass('empty-top');
                $('span').removeClass('empty-bottom');
            }

            $('.data-process .title span').empty();
            $('.data-process .subtitle').empty();
            $('.data-product .product span').empty();
            $('.data-responsible .responsible .circle strong').empty();
            $('.data-responsible .responsible span').empty();
            $('.data-date .date').empty();
            $('.hour span').empty();

            if (collection.length > 0) {
                for (i = 0; i < collection.length; i++) {
                    var datos = collection[i];
                    $('.data-process .title span').html(datos.Ambiente);
                    $('.data-process .subtitle').html(datos.Descripcion);

                    $('.data-product img').prop('src', '../products/' + datos.ImagenProducto);
                    $('.data-product .product span').html(datos.Producto);

                    $('.data-responsible .responsible .circle strong').html(datos.LetrasResponsable);
                    $('.data-responsible .responsible span').html(datos.Responsable);

                    (datos.Duracion !== 'Pendiente') ? $('.hour span').html(datos.Duracion) : $('.hour span').addClass('empty empty-top');

                    var init = (datos.Inicio !== null) ? new Date(datos.Inicio) : null;
                    var finish = (datos.Final !== null) ? new Date(datos.Final) : null;
                    var options_time = { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false };

                    const month = init.toLocaleDateString('es-ES', { month: 'long' });
                    const year = init.toLocaleDateString('es-ES', { year: 'numeric' });

                    $('.data-month span').html(isWeek(month));
                    $('.data-month .year').html(year);
                    $('.data-init .indicator span').html(init.toLocaleTimeString('es-PE', options_time));
                    $('.data-finish .indicator span').html(((finish !== null) ? finish.toLocaleTimeString('es-PE', options_time) : $('.data-finish .indicator span').addClass('empty')));

                    const weekday_init = init.toLocaleDateString('es-ES', { weekday: 'short' }).replace('.', '');
                    const day_init = init.toLocaleDateString('es-ES', { day: '2-digit' });
                    $('.data-date .date').append('<div class="day"><strong>' + isWeek(weekday_init) + '</strong><span>' + day_init + '</span></div>');

                    if (finish !== null) {
                        const weekday_finish = finish.toLocaleDateString('es-ES', { weekday: 'short' }).replace('.', '');
                        const day_finish = finish.toLocaleDateString('es-ES', { day: '2-digit' });

                        if (!isValidDate(init, finish)) {
                            $('.data-date .date').append('<div class="day"><strong>' + isWeek(weekday_finish) + '</strong><span>' + day_finish + '</span></div>');
                        }
                    }

                    inheritance.push({
                        Ambiente: datos.Ambiente,
                        Proceso: datos.Descripcion,
                        Inicio: new Date(datos.Inicio).toLocaleDateString('es-PE', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false}).replace(',', ''),
                        Final: ((datos.Final === null || datos.Final === '') ? '' : new Date(datos.Final).toLocaleDateString('es-PE', { year: 'numeric', month: '2-digit', day: '2-digit', hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false }).replace(',', '')),
                        Duracion: datos.Duracion,
                        Producto: datos.Producto,
                        Responsable: datos.Responsable
                    });
                }
            } else {

            }
        },
        complete: function () {
            /*Translate('device', 'designer');*/
        }, error: function (error) {

        }
    });
}
function Connectivity(process) {
