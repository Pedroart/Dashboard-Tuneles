                        $('.data-connectivity .wrapper-grid .grid').eq(1).append(
                            '<div class="element ' + ((datos.Visibilidad === true) ? 'green' : '') + '">' + datos.Sensor + '</div>'
                        );
                    }
                }
            } else {

            }
        },
        complete: function () {
            
        }, error: function (error) {

        }
    });
}
function Trends(process) {
    var data = { Identifier: process };

    $.ajax({
        type: "POST",
        contentType: "application/json",
        url: '/Reports/Trends',
        data: JSON.stringify(data),
        dataType: "json",
        async: true,
        beforeSend: function () {

        },
        success: function (data) {
            var collection = JSON.parse(data);
            var sensores = {};

            
            collection.forEach(item => {
                var key = item.Sensor;

                if (!sensores[key]) sensores[key] = [];

                sensores[key].push({
                    x: new Date(item.Fecha).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false }),
                    y: parseFloat(item.Valor),
                    unit: '°C',
                    date: new Date(item.Fecha).toLocaleDateString('es-PE', { year: 'numeric', month: '2-digit', day: '2-digit', hour12: false })
                });
            });

            var colores = [
                "#87cc2f", "#287bff", "#ff4f4f", "#ffa31a",
                "#9b59b6", "#1abc9c", "#e67e22", "#f1c40f"
            ];

            var datasets = [];
            var i = 0;

            for (var sensor in sensores) {
                const isAmbiente = sensor === "AMBIENTE";
                const isRetorno = sensor === "RETORNO";

                let color;

                if (isAmbiente) { color = "#aaa"; }
                else if (isRetorno) { color = "#ccc"; }
                else { color = colores[i % colores.length]; }

                datasets.push({
                    label: sensor,
                    data: sensores[sensor],
                    borderWidth: 3,
                    pointBorderWidth: 1,
                    pointBackgroundColor: color,
                    borderColor: color,
                    backgroundColor: "transparent",
                    fill: false,
                    tension: 0.5,
                    /*borderDash: (isAmbiente || isRetorno) ? [10, 5] : [] */
                });

                if (!isAmbiente && !isRetorno) i++;
            }

            //if (trends) {
            //    trends.data.datasets = datasets;
            //    trends.update();
            //    return;
            //}

            if (trends) {
                trends.destroy();
            }

            const ctx = document.getElementById('trends');
            ctx.height = 400;

            const verticalLine = {
                id: 'verticalLine',
                afterDatasetsDraw(chart, args, pluginOptions) {
                    const { ctx, tooltip, chartArea: { top, bottom } } = chart;

                    const active = tooltip?.getActiveElements?.();
                    if (!active || active.length === 0) return;

                    const [{ datasetIndex, index }] = active;
                    const x = chart.getDatasetMeta(datasetIndex).data[index].x;

                    ctx.save();
                    ctx.beginPath();
                    ctx.moveTo(x, top);
                    ctx.lineTo(x, bottom);
                    ctx.lineWidth = pluginOptions?.lineWidth ?? 3;
                    ctx.strokeStyle = pluginOptions?.color ?? 'rgba(255, 255, 255, 0.15)';
                    ctx.stroke();
                    ctx.restore();
                }
            };

            var context = document.getElementById('trends').getContext('2d');;
            var gradient = context.createLinearGradient(0, 0, 0, 350);
            gradient.addColorStop(0, '#87cc2f');
            gradient.addColorStop(1, 'rgba(0, 0, 0, 0)');

            trends = new Chart(ctx, {
                type: 'line',
                data: {
                    datasets: datasets
                },
                options: {
                    animation: false,
                    responsive: true,
                    maintainAspectRatio: false,
                    layout: {
                        padding: {
                            top: 15,
                            left: 15,
                            right: 15,
                            bottom: 15
                        }
                    },
                    interaction: {
                        intersect: false,
                        mode: 'index',
                    },
                    scales: {
                        y: {
                            display: true,
                            grid: {
                                display: false
                            },
                            title: {
                                display: false,
                                text: 'Temperaturas',
                                font: {
                                    size: 12,
                                    family: 'Arial',
                                    weight: 'bold'
                                },
                            },
                            ticks: {
                                font: {
                                    family: 'Arial',
                                    weight: 'bold'
                                },
                                callback: function (value) {
                                    return parseFloat(value).toFixed(1);
                                }
                            }
                        },
                        x: {
                            display: true,
                            offset: true,
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: {
                                    family: 'Arial',
                                    weight: 'bold'
                                },
                                maxRotation: 0,
                                minRotation: 0,
                                autoSkip: true,
                                autoSkipPadding: 10
                            }
                        }
                    },
                    elements: {
                        point: {
                            radius: 0
                        },
                        line: {
                            tension: 0.2
                        }
                    },
                    plugins: {
                        title: {
                            display: false,
                            text: 'MEDICIONES',
                            color: 'rgb(161, 161, 161)',
                            padding: { bottom: 15 },
                            font: {
                                size: 13,
                                weight: 'bold',
                                family: 'Roboto'
                            }
                        },
                        legend: {
                            display: true,
                            position: 'right',
                            labels: {
                                usePointStyle: true,
                                pointStyle: 'rectRounded',
                                boxWidth: 7,
                                boxHeight: 7,
                                color: 'white',
                                font: {
                                    size: 12
                                }
                            }
                        },
                        verticalLine: { color: 'rgba(255,255,255,0.15)', lineWidth: 3 },
                        tooltip: {
                            enabled: false,
                            external: function (context) {
                                const tooltipEl = document.getElementById('tooltip');
                                const tooltip = context.tooltip;

                                const legend = context.chart.legend.chart._metasets;
                                const visibles = legend.filter(item => !item.hidden);

                                if (!tooltip || tooltip.opacity === 0) {
                                    tooltipEl.style.display = 'none';
                                    return;
                                }

                                if (tooltip.body) {
                                    const index = tooltip.dataPoints[0].dataIndex;
                                    const titleLines = tooltip.title || [];

                                    const point = tooltip.dataPoints[0];
                                    const datasetRef = context.chart.data.datasets[point.datasetIndex];
                                    const rawDate = datasetRef.data[point.dataIndex].date;

                                    let innerHtml = '<div>';
                                    innerHtml += '<div class="title">' + (rawDate + ' ' + (titleLines[0] ?? '')) + '</div>';

                                    visibles.forEach((meta) => {
                                        const dataset = context.chart.data.datasets[meta.index];

                                        const datasetValue = dataset.data[index].y;
                                        const datasetColor = dataset.borderColor;
                                        const datasetUnit = dataset.data[index].unit;

                                        innerHtml +=
                                            '<div class="wrapper-data">' +
                                            '<div class="data">' +
                                            '<div class="circle" style="background:' + datasetColor + '"></div>' +
                                            '<strong>' + dataset.label + '</strong>' +
                                            '</div>' +
                                            '<div class="value">' +
                                            '<span>' + parseFloat(datasetValue).toFixed(1) + '</span>' +
                                            '<strong>' + datasetUnit + '</strong>' +
                                            '</div>' +
                                            '</div>';
                                    });

                                    innerHtml += '</div>';

                                    tooltipEl.innerHTML = innerHtml;
                                    tooltipEl.style.display = 'block';
                                    tooltipEl.style.opacity = 1;
                                }

                                const canvasPosition = context.chart.canvas.getBoundingClientRect();
                                tooltipEl.style.left = canvasPosition.left + window.scrollX + tooltip.caretX - (tooltip.width / 2) + 'px';
                                tooltipEl.style.top = canvasPosition.top + window.scrollY + tooltip.caretY + 5 + 'px';
                            },
                            displayColors: false,
                            callbacks: {
                                label: function (value) {
                                    return value.dataset.label + ' ' + parseFloat(value.raw).toFixed(1);
                                }
                            }
                        }

                    },
                    tooltips: {
                        enabled: true,
                        intersect: false,
                        mode: "index"
                    },
                    hover: {
                        mode: 'index',
                        intersect: false
                    }
                },
                plugins: [verticalLine]
            });
        },
        complete: function () {
            /*Translate('device', 'designer');*/
        }, error: function (error) {

        }
    });
}
function Workflow(process) {
    var data = { Identifier: process };

    $.ajax({
        type: "POST",
        contentType: "application/json",
        url: '/Reports/Workflow',
        data: JSON.stringify(data),
        dataType: "json",
        async: true,
        beforeSend: function () {

        },
        success: function (data) {
            var data = JSON.parse(data);
            

            $('.workflow').empty();
            const workflow = document.getElementById('workflow');

            const formatFechaLarga = fecha => new Date(fecha).toLocaleDateString('es-PE', { weekday: 'long', day: '2-digit', month: 'long', year: 'numeric' });
            const formatHora = fecha => new Date(fecha).toLocaleTimeString('es-PE', { hour: '2-digit', minute: '2-digit', hour12: false });

            const agrupado = data.reduce((acc, item) => {
                const dia = item.Fecha.split('T')[0];
                acc[dia] ??= [];
                acc[dia].push(item);
                return acc;
            }, {});

            

            Object.entries(agrupado).forEach(([dia, eventos]) => {

                const element = document.createElement('div');
                element.className = 'element';

                element.innerHTML = '<div class="date">' + longDate(dia) + '</div>';

                eventos.forEach(e => {

                    const context = document.createElement('div');
                    context.className = 'context';

                    context.innerHTML = 
                    '<div class="time">' + formatHora(e.Fecha) + '</div>' +
                    '<div class="list">' +
                    '<div class="operator">' +
                    '<div class="circle">' + e.Letras + '</div>' +
                    '<div class="content">' +
                    '<span class="title">' + e.Responsable + '</span>' +
                    '<b class="subtitle">' + ' ha <strong>' + e.Estado + '</strong> el proceso.' + '</b>' +
                    '</div>' +
                    (e.Comentarios ? '<div class="comments">' + '<div class="title">Comentarios</div>' + '<div class="content">' + '<span>' + e.Comentarios + '</span>' + '</div>' + '</div>' : '') +
                    '</div>' +
                    '</div>'
                    ;

                    element.appendChild(context);
                });

                workflow.appendChild(element);
            });
        },
        complete: function () {

        }, error: function (error) {

        }
    });
}
function Pallets(process) {
    var data = { Identifier: process };

    $.ajax({
        type: "POST",
        contentType: "application/json",
        url: '/Reports/Pallets',
        data: JSON.stringify(data),
        dataType: "json",
        async: true,
        beforeSend: function () {
            $('#paletas thead').empty();
            $('#paletas tbody').empty();
        },
        success: function (data) {
            var collection = JSON.parse(data);
            

            counter_pallets = collection.length;

            if (collection.length > 0) {
                var encabezados = [];
                for (var i = 0; i < 1; i++) {
                    var counter = collection[i];
                    $('#paletas thead').html('<tr></tr>');

                    for (key in counter) {
                        if (key.toLowerCase() === 'identificador') continue;
                        $('#paletas thead tr:last').append('<th><div class="flex">' + key.replace(/_/g, ' ') + '</div></th>');
                        var headers = 'counter.' + key;
                        encabezados.push(headers);
                    }
                }

                for (var i = 0; i < collection.length; i++) {
                    var counter = collection[i];
                    $('#paletas tbody').append('<tr class="active" data-identifier="' + counter.Identificador + '" data-code="' + counter.Codigo + '"></tr>');
                    for (var x = 0; x < encabezados.length; x++) {
                        $('#paletas tbody tr:last').append('<td><div class="flex">' + eval(encabezados[x]) + '</div></td>');
                    }
                }
            } else {
                $('#paletas thead').html('<tr><th><div class="flex">Codigo</div></th><th><div class="flex">Sensor</div></th><th><div class="flex">Variedades</div></th><th><div class="flex">Envases</div></th><th><div class="flex">Calibre</div></th></tr>');
                $('#paletas tbody').append('<tr class="no-hover"></tr>');
                $('#paletas tbody tr').append('<td colspan="5"><div class="flex center">' + 'No se encontraron paletas' + '</div></td>');
            }

        }, complete: function (respuesta) {
           
        }, error: function (result) {

        }
    });
}
