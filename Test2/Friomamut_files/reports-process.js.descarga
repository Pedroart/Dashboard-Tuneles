$('#status').change(function () {
    var _init = $('#init').val();
    var _finish = $('#finish').val();

    var environments = $('#environments option:selected').val();
    var status = $('#status option:selected').val();

    var parameters = [];
    var content = { Init: _init, Finish: _finish, Environment: parseInt(environments), Status: parseInt(status) };
    parameters.push(content);

    Filter(JSON.stringify(parameters));
});

$('.wrapper-filter .filter').click(function () {
    var validate = $('.wrapper-handpick .handpick .group .content .element').is('.active');
    
    if (validate) {
        identifier = $('.wrapper-handpick .handpick .group .content .element.active')[0].dataset.identifier;

        if (trends) {
            trends.destroy();
        }

        Process(identifier);
        Connectivity(identifier);
        Trends(identifier);
        Workflow(identifier);
        Pallets(identifier);
        Usability(identifier);
        Measurements(identifier);

        $('.wrapper-context').fadeOut(100);
        $('.wrapper-context .context').css({ 'transform': 'translateX(100%)' });
    }
})
$('.wrapper-download .download').off().on('click', function () {
    Export();
})
function Export() {
    let tabla = document.getElementById("measurements");

    let wb = XLSX.utils.table_to_book(tabla, { sheet: "Mediciones" });
    let ws = wb.Sheets["Mediciones"];

    let rango = XLSX.utils.decode_range(ws['!ref']);

    for (let i = rango.s.r + 1; i <= rango.e.r; i++) {
        let celda = ws['A' + (i + 1)];
        if (celda) {
            celda.z = "dd/mm/yyyy HH:mm:ss";
        }
    }

    ws['!cols'] = [];
    ws['!cols'][0] = { wch: 22 };

    let resumen = XLSX.utils.json_to_sheet(inheritance, {
        header: ["Ambiente", "Proceso", "Inicio", "Final", "Duracion", "Producto", "Responsable"]
    });
    resumen['!cols'] = [
        { wch: 10 },
        { wch: 20 },
        { wch: 20 },
        { wch: 20 },
        { wch: 15 },
        { wch: 15 },
        { wch: 20 }
    ];
    XLSX.utils.book_append_sheet(wb, resumen, "Datos");

    XLSX.writeFile(wb, inheritance[0].Ambiente + ' ' + inheritance[0].Proceso + ".xlsx");
}